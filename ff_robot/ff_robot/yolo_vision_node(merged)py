#!/usr/bin/env python3
# yolo_vision_node_merged.py
# 병합된 버전: 성능 최적화(QoS, GPU) + 디버그 뷰 + 사용자 확인 옵션

import rclpy
from rclpy.node import Node
from rclpy.executors import MultiThreadedExecutor
from rclpy.callback_groups import ReentrantCallbackGroup
from sensor_msgs.msg import Image, CameraInfo
from cv_bridge import CvBridge
import cv2
import numpy as np
from ultralytics import YOLO
import time
import os

# [QoS 설정] RealSense와의 호환성을 위해 필수 (File 2 기반)
from rclpy.qos import QoSProfile, ReliabilityPolicy, HistoryPolicy, DurabilityPolicy

from ff_robot_interfaces.srv import DetectObject 
from geometry_msgs.msg import Point, Quaternion

# =========================================================
# [사용자 설정] 입맛대로 켜고 끄세요
# =========================================================
USE_DEBUG_WINDOW = True      # True: 인식된 화면을 팝업창으로 띄움 (File 1 기능)
REQUIRE_USER_CONFIRM = False # True: 화면에서 'Enter'를 눌러야 로봇에게 좌표 전송 (File 1 기능)
                             # False: 인식되면 즉시 전송 (File 2 기능 - 자동화용)
FIXED_DEPTH_MM = 600.0       # 깊이 값이 0일 때 사용할 기본 거리
# =========================================================

class YoloVisionNode(Node):
    def __init__(self):
        super().__init__('yolo_vision_node')
        
        self.get_logger().info("=========================================")
        self.get_logger().info("🚀 YOLO Vision Node (Merged Version)")
        self.get_logger().info(f"👉 디버그 화면: {USE_DEBUG_WINDOW}")
        self.get_logger().info(f"👉 사용자 확인 대기: {REQUIRE_USER_CONFIRM}")
        self.get_logger().info("=========================================")
        
        current_dir = os.path.dirname(os.path.abspath(__file__))
        self.model_path = os.path.join(current_dir, "models", "best.pt")
        
        self.bridge = CvBridge()
        self.latest_color_img = None
        self.latest_depth_img = None
        self.camera_intrinsics = None 
        
        # [모델 로드 및 최적화]
        try:
            self.model = YOLO(self.model_path)
            device = self.model.device
            self.get_logger().info(f"✅ YOLO 모델 로드 완료 (Device: {device})")
            
            # [GPU 워밍업] 첫 추론 렉 방지 (File 2 기능)
            dummy_img = np.zeros((640, 640, 3), dtype=np.uint8)
            _ = self.model(dummy_img, verbose=False)
            self.get_logger().info("✅ GPU 워밍업 완료")
            
        except Exception as e:
            self.get_logger().error(f"모델 로드 실패: {e}")

        # [QoS 프로필] RealSense와 통신 끊김 방지 (File 2 기능)
        qos_profile = QoSProfile(
            reliability=ReliabilityPolicy.RELIABLE,
            durability=DurabilityPolicy.VOLATILE,
            history=HistoryPolicy.KEEP_LAST,
            depth=1
        )

        self.cb_group = ReentrantCallbackGroup()

        self.create_subscription(Image, '/camera/camera/color/image_raw', self.color_callback, qos_profile, callback_group=self.cb_group)
        self.create_subscription(Image, '/camera/camera/aligned_depth_to_color/image_raw', self.depth_callback, qos_profile, callback_group=self.cb_group)
        self.create_subscription(CameraInfo, '/camera/camera/color/camera_info', self.info_callback, qos_profile, callback_group=self.cb_group)

        self.srv = self.create_service(DetectObject, '/dsr01/detect_object', self.handle_detect_object, callback_group=self.cb_group)
        self.get_logger().info("👀 서비스 서버 준비 완료")

    def color_callback(self, msg):
        try: self.latest_color_img = self.bridge.imgmsg_to_cv2(msg, "bgr8")
        except: pass

    def depth_callback(self, msg):
        try: self.latest_depth_img = self.bridge.imgmsg_to_cv2(msg, "16UC1")
        except: pass

    def info_callback(self, msg):
        if self.camera_intrinsics is None:
            K = msg.k
            self.camera_intrinsics = {'fx': K[0], 'fy': K[4], 'ppx': K[2], 'ppy': K[5]}
            # self.get_logger().info("✅ 카메라 파라미터 수신 완료")

    def pixel_to_3d_cam(self, u, v, depth_mm):
        if self.camera_intrinsics is None: return None
        z = depth_mm / 1000.0 
        if z <= 0: return None
        x = (u - self.camera_intrinsics['ppx']) * z / self.camera_intrinsics['fx']
        y = (v - self.camera_intrinsics['ppy']) * z / self.camera_intrinsics['fy']
        return np.array([x, y, z])

    def handle_detect_object(self, request, response):
        target_name = request.target_object_id
        self.get_logger().info(f"🔎 YOLO 요청 수신: '{target_name}'")

        inference_start = time.time()

        # 1. 이미지 대기 (타임아웃 단축 - File 2 기능)
        if self.latest_color_img is None or self.latest_depth_img is None:
            wait_start = time.time()
            while self.latest_color_img is None or self.latest_depth_img is None:
                if time.time() - wait_start > 2.0: # 2초 대기
                    self.get_logger().error(f"❌ [Timeout] 이미지 수신 실패")
                    response.found = False
                    return response
                time.sleep(0.01)

        # 2. YOLO 추론
        yolo_start = time.time()
        results = self.model(self.latest_color_img, verbose=False)
        yolo_time = (time.time() - yolo_start) * 1000
        
        # [디버그용 이미지 복사] (File 1 기능 복구)
        debug_img = self.latest_color_img.copy() if USE_DEBUG_WINDOW else None

        found_target = False
        center_x, center_y = 0, 0
        box_w, box_h = 20, 20
        rotation_rad = 0.0

        # 결과 파싱 (OBB 우선, 없으면 Box)
        for r in results:
            # OBB (Oriented Bounding Box) - 회전 감지됨
            if r.obb is not None:
                for box in r.obb:
                    cls_id = int(box.cls[0])
                    cls_name = self.model.names[cls_id]
                    
                    # [시각화] 모든 박스 그리기
                    if USE_DEBUG_WINDOW:
                        pts = box.xyxyxyxy[0].cpu().numpy().reshape((-1, 1, 2)).astype(np.int32)
                        cv2.polylines(debug_img, [pts], True, (255, 0, 0), 2)
                        cv2.putText(debug_img, cls_name, (pts[0][0][0], pts[0][0][1]-10), 
                                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 0, 0), 2)

                    if cls_name == target_name:
                        c_x, c_y, w, h, rot = box.xywhr[0].cpu().numpy()
                        center_x, center_y = int(c_x), int(c_y)
                        box_w, box_h = int(w), int(h)
                        rotation_rad = float(rot)
                        found_target = True
                        
                        # [시각화] 타겟 강조
                        if USE_DEBUG_WINDOW:
                            cv2.circle(debug_img, (center_x, center_y), 8, (0, 0, 255), -1)
                            cv2.putText(debug_img, "TARGET", (center_x+10, center_y), 
                                        cv2.FONT_HERSHEY_bold, 0.8, (0, 0, 255), 2)
                        break

            # Normal Box (회전 없음)
            if not found_target and r.boxes is not None:
                for box in r.boxes:
                    cls_id = int(box.cls[0])
                    cls_name = self.model.names[cls_id]

                    # [시각화] 박스 그리기
                    if USE_DEBUG_WINDOW:
                        x1, y1, x2, y2 = map(int, box.xyxy[0])
                        cv2.rectangle(debug_img, (x1, y1), (x2, y2), (255, 0, 0), 2)

                    if cls_name == target_name:
                        x1, y1, x2, y2 = map(int, box.xyxy[0])
                        center_x = int((x1+x2)/2)
                        center_y = int((y1+y2)/2)
                        box_w, box_h = abs(x2-x1), abs(y2-y1)
                        found_target = True
                        
                        if USE_DEBUG_WINDOW:
                            cv2.circle(debug_img, (center_x, center_y), 8, (0, 0, 255), -1)
                        break
            
            if found_target: break

        # 3. 타겟 못 찾음 처리
        if not found_target:
            self.get_logger().warn(f"   ⚠️ 타겟 '{target_name}' 없음")
            if USE_DEBUG_WINDOW:
                cv2.imshow(f"Check: {target_name}", debug_img)
                cv2.waitKey(100) # 잠깐 보여주고 넘어감
            response.found = False
            return response

        # 4. Depth 추출
        h_img, w_img = self.latest_depth_img.shape
        roi_w = max(5, int(box_w * 0.3))
        roi_h = max(5, int(box_h * 0.3))
        x_min = max(0, center_x - roi_w // 2)
        x_max = min(w_img, center_x + roi_w // 2)
        y_min = max(0, center_y - roi_h // 2)
        y_max = min(h_img, center_y + roi_h // 2)
        
        roi = self.latest_depth_img[y_min:y_max, x_min:x_max]
        valid_depths = roi[roi > 0]
        
        if len(valid_depths) == 0:
            depth_mm = FIXED_DEPTH_MM
            self.get_logger().warn(f"   ⚠️ Depth 0 -> 고정값 {FIXED_DEPTH_MM}mm 사용")
        else:
            depth_mm = float(np.median(valid_depths))

        # 5. 좌표 변환
        cam_point = self.pixel_to_3d_cam(center_x, center_y, depth_mm)
        if cam_point is None:
            self.get_logger().error("   ❌ 3D 변환 실패")
            response.found = False
            return response

        # =================================================================
        # [옵션] 시각화 및 사용자 확인 (File 1 기능 통합)
        # =================================================================
        if USE_DEBUG_WINDOW:
            info_txt = f"X:{cam_point[0]:.2f} Y:{cam_point[1]:.2f} Z:{cam_point[2]:.2f} R:{np.degrees(rotation_rad):.1f}"
            cv2.putText(debug_img, info_txt, (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)
            
            win_name = f"Detect: {target_name}"
            
            if REQUIRE_USER_CONFIRM:
                # [Blocking] Enter 키 대기 모드
                cv2.putText(debug_img, "Press [ENTER] to Send", (10, 60), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 255), 2)
                cv2.imshow(win_name, debug_img)
                self.get_logger().warn("⌨️  [Wait] Enter 키를 눌러 좌표를 전송하세요...")
                
                while True:
                    key = cv2.waitKey(100)
                    if key == 13: # Enter
                        self.get_logger().info("✅ 승인됨")
                        cv2.destroyWindow(win_name)
                        break
                    elif key == 27: # ESC
                        self.get_logger().warn("🚫 취소됨")
                        cv2.destroyWindow(win_name)
                        response.found = False
                        return response
            else:
                # [Non-Blocking] 그냥 보여주고 즉시 통과
                cv2.imshow(win_name, debug_img)
                cv2.waitKey(1) # 화면 갱신용
        # =================================================================

        # 6. 결과 반환 (File 2의 좌표 보정 & 회전값 적용)
        response.found = True
        response.position = Point(x=cam_point[0], y=cam_point[1], z=cam_point[2])
        
        # 회전값(rad) -> Quaternion 변환 (Z축 회전)
        half_angle = rotation_rad / 2.0
        qz = np.sin(half_angle)
        qw = np.cos(half_angle)
        response.orientation = Quaternion(x=0.0, y=0.0, z=qz, w=qw) 
        
        # [로그] 보정된 좌표 (로봇 베이스 기준 추정값 - File 2 설정 유지)
        x_mm = cam_point[0] * 1000.0
        y_mm = cam_point[1] * 1000.0 - 20.0  # 보정값
        z_mm = cam_point[2] * 1000.0 + 170.0 # 보정값
        
        total_time = (time.time() - inference_start) * 1000
        self.get_logger().info(
            f"   ✅ 전송(mm): X={x_mm:.1f}, Y={y_mm:.1f}, Z={z_mm:.1f} | 각도: {np.degrees(rotation_rad):.1f}° | 시간: {total_time:.0f}ms"
        )
        
        return response

def main(args=None):
    rclpy.init(args=args)
    node = YoloVisionNode()
    executor = MultiThreadedExecutor()
    executor.add_node(node)
    try: executor.spin()
    except KeyboardInterrupt: pass
    finally:
        node.destroy_node()
        rclpy.shutdown()
        cv2.destroyAllWindows()

if __name__ == '__main__':
    main()