    <limit velocity="3.14" effort="10.6" lower="-1.57" upper="1.57" />
    <mimic joint="rg2_finger_joint1" multiplier="-1"/>
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="rg2_r_truss_arm_link">
    <visual>
      <geometry>
        <mesh filename="package://robot_description/meshes/rg2_new/visual/RG2_RightTrussArm_vis.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://robot_description/meshes/rg2_new/collision/RG2_RightTrussArm_col.STL"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.023075 -0.012136 -0.010000" rpy="0 0 0"/>
      <mass value="0.065"/>
      <inertia ixx="0.000010" ixy="-0.000010" ixz="0" iyy="0.000024" iyz="0" izz="0.000025"/>
    </inertial>
  </link>

<gazebo reference="rg2_hand_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <material>Gazebo/White</material>
    <selfCollide>false</selfCollide> </gazebo>

  <gazebo reference="rg2_l_moment_arm_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <material>Gazebo/White</material>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="rg2_l_truss_arm_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <material>Gazebo/White</material>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="rg2_l_finger_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <material>Gazebo/White</material>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="rg2_r_moment_arm_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <material>Gazebo/White</material>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="rg2_r_truss_arm_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <material>Gazebo/White</material>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="rg2_r_finger_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <material>Gazebo/White</material>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo>
    <plugin name="rg2_l_finger_2_joint_mimic_plugin" filename="libroboticsgroup_gazebo_mimic_joint_plugin.so">
      <joint>rg2_finger_joint1</joint>
      <mimicJoint>rg2_l_finger_2_joint</mimicJoint>
      <multiplier>-1.0</multiplier>
      <offset>0</offset>
      <maxEffort>10.6</maxEffort>
    </plugin>

    <plugin name="rg2_l_finger_passive_joint_mimic_plugin" filename="libroboticsgroup_gazebo_mimic_joint_plugin.so">
      <joint>rg2_finger_joint1</joint>
      <mimicJoint>rg2_l_finger_passive_joint</mimicJoint>
      <multiplier>1.0</multiplier>
      <offset>0</offset>
      <maxEffort>10.6</maxEffort>
    </plugin>

    <plugin name="rg2_r_finger_1_joint_mimic_plugin" filename="libroboticsgroup_gazebo_mimic_joint_plugin.so">
      <joint>rg2_finger_joint1</joint>
      <mimicJoint>rg2_r_finger_1_joint</mimicJoint>
      <multiplier>-1.0</multiplier>
      <offset>0</offset>
      <maxEffort>10.6</maxEffort>
    </plugin>

    <plugin name="rg2_r_finger_2_joint_mimic_plugin" filename="libroboticsgroup_gazebo_mimic_joint_plugin.so">
      <joint>rg2_finger_joint1</joint>
      <mimicJoint>rg2_r_finger_2_joint</mimicJoint>
      <multiplier>1.0</multiplier>
      <offset>0</offset>
      <maxEffort>10.6</maxEffort>
    </plugin>

    <plugin name="rg2_r_finger_passive_joint_mimic_plugin" filename="libroboticsgroup_gazebo_mimic_joint_plugin.so">
      <joint>rg2_finger_joint1</joint>
      <mimicJoint>rg2_r_finger_passive_joint</mimicJoint>
      <multiplier>-1.0</multiplier>
      <offset>0</offset>
      <maxEffort>10.6</maxEffort>
    </plugin>
    
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find dsr_moveit_config)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <material name="d435i_black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <joint name="camera_mount_joint" type="fixed">
    <!-- <origin xyz="0.05 0 0.03" rpy="0 0 0"/> -->
    <!-- <origin xyz="-0.05 0 -0.03" rpy="3.14159 0 3.14159"/> -->
    <origin xyz="-0.05 0 -0.03" rpy="0 -1.5708 0"/>
    <parent link="link_6"/>
    <child link="camera_base_link"/>
  </joint>

  <link name="camera_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
      <material name="d435i_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.072"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257"/>
    </inertial>
  </link>
  <!-- 광학용 가짜 링크(Optical Frame) -->
  <link name="camera_depth_optical_frame"/>

  <joint name="camera_depth_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/> <parent link="camera_base_link"/>
    <child link="camera_depth_optical_frame"/>
  </joint>

  <gazebo reference="camera_base_link">
    <sensor name="d435i" type="depth">
      <visualize>true</visualize>
      <update_rate>30.0</update_rate>
      <camera name="head">
        <horizontal_fov>1.518</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>dsr01</namespace>
          <remapping>d435i/image_raw:=camera/color/image_raw</remapping>
          <remapping>d435i/depth/image_raw:=camera/depth/image_rect_raw</remapping>
          <remapping>d435i/points:=camera/depth/color/points</remapping>
        </ros>
        <camera_name>d435i</camera_name>
        <!-- <frame_name>camera_base_link</frame_name> -->
        <frame_name>camera_depth_optical_frame</frame_name>
        <min_depth>0.1</min_depth>
        <max_depth>10.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    
    <joint name="joint_1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rg2_finger_joint1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!-- <joint name="rg2_finger_joint2">
      <param name="mimic">rg2_finger_joint1</param>
      <param name="multiplier">1</param>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint> -->

  </ros2_control>

  <!-- <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find robot_description)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo> -->
  
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find dsr_moveit_config)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>


</robot>

