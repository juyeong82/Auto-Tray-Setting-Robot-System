# OrderService.srv

# =========== Request (Kiosk -> Main) ===========
string[] item_names # 주문할 메뉴 이름 리스트 (예: ["hamburger", "fries"])
int32[] item_quantities # 각 메뉴의 수량 리스트 (예: [2, 1]) --주의: item_names와 길이 일치

---

# =========== Response (Main -> Kiosk) ===========
string assigned_order_id    # 서버가 발급한 주문 번호 (예: "ORD-20231127-01")- 실패 시 빈 문자열
string message  # 사용자에게 보여줄 메시지 ("주문이 완료되었습니다", "재고 부족: 햄버거")

int32 estimated_time    # 예상 대기 시간 (초)

# [UI 갱신용] 변경된 재고 정보
string[] all_item_ids   # 모든 메뉴 아이디 리스트
int32[] all_item_counts # 각 메뉴의 남은 재고 수량 리스트 (item_ids와 길이 일치)