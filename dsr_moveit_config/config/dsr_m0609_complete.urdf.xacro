<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dsr_m0609_complete">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import dsr_m0609_complete urdf file -->
    <xacro:include filename="$(find robot_description)/urdf/dsr_combined_fixed3.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="dsr_m0609_complete.ros2_control.xacro" />


    <xacro:dsr_m0609_complete_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
